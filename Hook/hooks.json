{
  "description": "项目长期记忆与当前对话标题整理 Hook。",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CODEX_AGENTS_CONFIG_ROOT/Hook/project_memory_session_start.py\"",
            "commandWindows": "py -3 \"%CODEX_AGENTS_CONFIG_ROOT%\\Hook\\project_memory_session_start.py\"",
            "timeout": 3,
            "statusMessage": "检查项目记忆摘要",
            "additionalContextLimit": 1500
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CODEX_AGENTS_CONFIG_ROOT/Hook/conversation_title_session_end.py\"",
            "commandWindows": "py -3 \"%CODEX_AGENTS_CONFIG_ROOT%\\Hook\\conversation_title_session_end.py\"",
            "timeout": 3,
            "statusMessage": "检查并整理当前对话标题"
          }
        ]
      },
      {
        "matcher": "other",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CODEX_AGENTS_CONFIG_ROOT/Hook/project_memory_session_end.py\"",
            "commandWindows": "py -3 \"%CODEX_AGENTS_CONFIG_ROOT%\\Hook\\project_memory_session_end.py\"",
            "timeout": 3,
            "statusMessage": "登记待审核项目记忆"
          }
        ]
      }
    ]
  }
}
